{
  "name": "skincare-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote -c seeds/wrangler.preview-db.jsonc",
    "db:seed:preview": "wrangler d1 execute DB --remote -c seeds/wrangler.preview-db.jsonc --file=seeds/preview.sql",
    "db:migrate:prod": "wrangler d1 migrations apply skincare-tracker-prod --remote"
  },
  "dependencies": {
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
