{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devhouse-template",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // D25: production binds the production D1; previews bind only the preview D1 (fake data).
  // Previews do not inherit production bindings, so everything a preview needs is repeated below.
  "vars": { "ENVIRONMENT": "production" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devhouse-template-prod",
      "database_id": "65b3f920-29ae-41e8-bca4-b3ae113b7d4b",
      "migrations_dir": "migrations",
    },
  ],
  "previews": {
    "vars": { "ENVIRONMENT": "preview" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "devhouse-template-preview",
        "database_id": "996c8f68-82e1-4d06-99e0-1711b997d598",
        "migrations_dir": "migrations",
      },
    ],
  },
}
