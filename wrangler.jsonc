{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skincare-tracker",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // D25: production binds the production D1; previews bind only the preview D1 (fake data).
  // Previews do not inherit production bindings, so everything a preview needs is repeated below.
  "vars": { "ENVIRONMENT": "production" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skincare-tracker-prod",
      "database_id": "6520f69a-d61a-4d81-afd8-ffe368a13594",
      "migrations_dir": "migrations",
    },
  ],
  "previews": {
    "vars": { "ENVIRONMENT": "preview" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "skincare-tracker-preview",
        "database_id": "f82718a5-0cf1-4256-958f-ba1c46c9336d",
        "migrations_dir": "migrations",
      },
    ],
  },
}
