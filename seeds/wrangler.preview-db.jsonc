{
  // Used only by the db:*:preview scripts: wrangler d1 commands read just the top-level
  // bindings, so the preview database needs its own config. Never add the prod database here.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "skincare-tracker",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skincare-tracker-preview",
      "database_id": "f82718a5-0cf1-4256-958f-ba1c46c9336d",
      "migrations_dir": "../migrations",
    },
  ],
}
